PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/crm_qlcv
JWT_SECRET=crm_qlcv_jwt_secret_key_production_should_use_strong_random_string_2026
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Google OAuth 2.0 Client ID (Lấy từ Google Cloud Console)
GOOGLE_CLIENT_ID=

# Email / SMTP Gmail (Dùng Google App Password 16 chữ số)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
EMAIL_FROM="CRM Quản Lý Công Việc" <your_email@gmail.com>
